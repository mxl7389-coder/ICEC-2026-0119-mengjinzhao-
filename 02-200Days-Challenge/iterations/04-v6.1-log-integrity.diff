+function sameOrigin(req) {
+  const raw = req.headers.origin || req.headers.referer || '';
+  if (!raw) return true;
+  try {
+    return new URL(raw).host.toLowerCase() === String(req.headers.host || '').toLowerCase();
+  } catch (_) { return false; }
